{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test Report Artifact",
  "description": "Test report artifact produced by the QA Engineer",
  "type": "object",
  "required": ["summary", "total_tests", "passed", "failed"],
  "properties": {
    "version": {"type": "integer"},
    "stage": {"type": "string", "const": "testing"},
    "run_id": {"type": "string"},
    "summary": {"type": "string"},
    "total_tests": {"type": "integer"},
    "passed": {"type": "integer"},
    "failed": {"type": "integer"},
    "skipped": {"type": "integer"},
    "coverage_percent": {"type": "number"},
    "test_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string", "enum": ["passed", "failed", "skipped"]},
          "details": {"type": "string"}
        }
      }
    },
    "issues_found": {
      "type": "array",
      "items": {"type": "string"}
    },
    "created_at": {"type": "string"}
  }
}
