{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRD Artifact",
  "description": "Product Requirements Document artifact produced by the Requirements Analyst",
  "type": "object",
  "required": ["title", "problem_statement", "functional_requirements"],
  "properties": {
    "version": {"type": "integer"},
    "stage": {"type": "string", "const": "requirements"},
    "run_id": {"type": "string"},
    "title": {"type": "string"},
    "problem_statement": {"type": "string"},
    "target_users": {
      "type": "array",
      "items": {"type": "string"}
    },
    "functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "priority": {"type": "string", "enum": ["high", "medium", "low"]},
          "acceptance_criteria": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "description": {"type": "string"},
          "threshold": {"type": "string"}
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "clarifying_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {"type": "string"},
          "answer": {"type": "string"}
        }
      }
    },
    "created_at": {"type": "string"}
  }
}
